# ─────────────────────────────────────────────
# BASE DE DATOS PostgreSQL
# ─────────────────────────────────────────────
# Local:
#   postgresql://usuario:contraseña@localhost:5432/perfume_shop
#
# Azure Database for PostgreSQL (Flexible Server):
#   postgresql://dbadmin%40servidor:contraseña@servidor.postgres.database.azure.com:5432/perfumes?sslmode=require
#   (nota: el @ del usuario debe ir codificado como %40)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/perfume_shop?sslmode=require"

# ─────────────────────────────────────────────
# JWT — texto largo y aleatorio (mín. 32 chars)
# ─────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"

# ─────────────────────────────────────────────
# CLOUDINARY — imágenes de productos
# Crear cuenta gratis en cloudinary.com
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ─────────────────────────────────────────────
# CORS — URL del frontend en producción
# Azure Static Web Apps: https://xxx.azurestaticapps.net
# ─────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ─────────────────────────────────────────────
# SERVIDOR
# Azure App Service asigna el puerto automáticamente
# mediante la variable PORT — no cambiar en producción
# ─────────────────────────────────────────────
PORT=3001

# ─────────────────────────────────────────────
# STRIPE — pagos con tarjeta
# Crear cuenta en stripe.com → Developers → API keys
# Usar claves "test" para desarrollo, "live" para producción
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."

# ─────────────────────────────────────────────
# EMAIL (opcional)
# ─────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu_email@gmail.com"
SMTP_PASS="tu_app_password_de_gmail"
